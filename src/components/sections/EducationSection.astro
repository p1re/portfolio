---
import { education } from "../../data/portfolio";
import SectionHeading from "./SectionHeading.astro";
---

<section
  class="education section-block"
  id="education"
  aria-labelledby="education-title"
>
  <SectionHeading
    id="education-title"
    eyebrow="03 / Formación"
    title="Mi recorrido."
    description="La formación que me dio una base para seguir creciendo en tecnología."
  />
  <ol class="education-list">
    {
      education.map((item, index) => (
        <li class="education-item">
          <span class="education-index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section-block {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .education-list {
    position: relative;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .education-list::before {
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: 0.95rem;
    width: 1px;
    background: var(--color-border);
    content: "";
  }

  .education-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .education-index {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  h3 {
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }

  p {
    max-width: 52rem;
    margin: 0;
  }

  @media (max-width: 480px) {
    .education-item {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
    }

    .education-list::before {
      left: 0.95rem;
    }
  }
</style>
