---
interface Props {
  activePage?: string;
}

const { activePage = "home" } = Astro.props;

const links = [
  {
    name: "Inicio",
    page: "home",
    href: "/#home",
    section: activePage === "home" ? "home" : undefined,
  },
  {
    name: "Sobre mí",
    page: "about",
    href: "/#about",
    section: activePage === "home" ? "about" : undefined,
  },
  {
    name: "Proyectos",
    page: "projects",
    href: activePage === "projects" ? "/projects" : "/#projects",
    section: activePage === "home" ? "projects" : undefined,
  },
  {
    name: "Formación",
    page: "education",
    href: activePage === "more" ? "/more#education" : "/#education",
    section: activePage === "home" || activePage === "more" ? "education" : undefined,
  },
  {
    name: "Tecnologías",
    page: "technologies",
    href: activePage === "more" ? "/more#technologies" : "/#technologies",
    section: activePage === "home" || activePage === "more" ? "technologies" : undefined,
  },
  { name: "Blog", page: "blog", href: "/blog" },
];

const isCurrentPage = (page: string) =>
  activePage === page || (activePage === "more" && page === "education");
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Nil Díaz, inicio">ND.</a>

  <button
    class="menu-toggle"
    type="button"
    data-menu-toggle
    aria-controls="site-navigation"
    aria-expanded="false"
    aria-label="Abrir navegación"
  >
    <span>Menú</span>
    <span class="menu-icon" aria-hidden="true"></span>
  </button>

  <nav id="site-navigation" aria-label="Navegación principal">
    <ul class="nav-links">
      {
        links.map(({ name, page, href, section }) => (
          <li>
            <a
              href={href}
              class:active={isCurrentPage(page)}
              data-section={section}
              aria-current={isCurrentPage(page) ? "page" : undefined}
            >
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button
    class="theme-toggle"
    type="button"
    data-theme-toggle
    role="switch"
    aria-label="Modo claro"
    aria-checked="false"
    title="Alternar modo claro y oscuro"
  >
    <span class="theme-toggle-thumb" aria-hidden="true"></span>
    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
      />
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
    </svg>
  </button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, var(--content-width));
    min-height: 4.5rem;
    margin: 0.75rem auto 0;
    padding: 0 clamp(1rem, 2vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.08);
  }

  .brand {
    justify-self: start;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    text-decoration: none;
  }

  nav {
    justify-self: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 1.4vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active {
    color: var(--color-accent);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after,
  .nav-links a.active::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    position: relative;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    width: 5.5rem;
    min-width: 5.5rem;
    max-width: 5.5rem;
    height: 2.625rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-raised);
    cursor: pointer;
    transition: border-color 200ms ease;
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 50%;
    left: 3px;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-switch-thumb);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.24);
    transform: translate(3rem, -50%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(:root[data-theme="light"]) .theme-toggle-thumb {
    transform: translateY(-50%);
  }

  .theme-toggle svg {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: var(--color-text-subtle);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transform: translateY(-50%);
  }

  .icon-sun {
    left: 0.6875rem;
  }

  .icon-moon {
    right: 0.6875rem;
  }

  :global(:root[data-theme="light"]) .icon-sun,
  :global(:root:not([data-theme="light"])) .icon-moon {
    stroke: var(--color-switch-icon-active);
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  .theme-toggle:focus-visible,
  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .site-header {
      grid-template-columns: 1fr auto auto;
      gap: 1rem;
      min-height: 4rem;
      padding: 0 1rem;
      border-radius: 1rem;
    }

    .nav-links a {
      font-size: 1rem;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      justify-self: end;
      padding: 0.5rem 0;
      border: 0;
      background: transparent;
      color: var(--color-text);
      font: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
    }

    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 1.1rem;
      height: 2px;
      border-radius: 1px;
      background: currentColor;
      transition: transform 180ms ease;
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before,
    .menu-icon::after {
      position: absolute;
      left: 0;
      content: "";
    }

    .menu-icon::before {
      transform: translateY(-0.35rem);
    }

    .menu-icon::after {
      transform: translateY(0.35rem);
    }

    .menu-toggle[aria-expanded="true"] .menu-icon {
      background: transparent;
    }

    .menu-toggle[aria-expanded="true"] .menu-icon::before {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .menu-icon::after {
      transform: rotate(-45deg);
    }

    nav {
      position: absolute;
      top: calc(100% + 1px);
      right: 0;
      left: 0;
      display: none;
      padding: 0.75rem 1rem 1rem;
      border: 1px solid var(--color-border);
      border-top: 0;
      border-radius: 0 0 1rem 1rem;
      background: var(--color-background);
      box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.16);
    }

    nav.is-open {
      display: block;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .nav-links a {
      min-height: 3.25rem;
      font-size: 1.1rem;
    }

    .nav-links a::after {
      right: auto;
      width: 2.5rem;
      bottom: 0.25rem;
    }

    .theme-toggle {
      width: 4.75rem;
      min-width: 4.75rem;
      max-width: 4.75rem;
      height: 2.375rem;
    }

    .theme-toggle-thumb {
      width: 1.75rem;
      height: 1.75rem;
      transform: translate(2.375rem, -50%);
    }

    :global(:root[data-theme="light"]) .theme-toggle-thumb {
      transform: translateY(-50%);
    }

    .theme-toggle svg {
      width: 1rem;
      height: 1rem;
    }

    .icon-sun {
      left: 0.625rem;
    }

    .icon-moon {
      right: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle-thumb,
    .nav-links a,
    .nav-links a::after,
    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      transition: none;
    }
  }
</style>

<script>
  const menuToggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const navigation = document.querySelector<HTMLElement>("#site-navigation");
  const themeToggle =
    document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function setMenuOpen(isOpen: boolean) {
    navigation?.classList.toggle("is-open", isOpen);
    menuToggle?.setAttribute("aria-expanded", String(isOpen));
    menuToggle?.setAttribute(
      "aria-label",
      isOpen ? "Cerrar navegación" : "Abrir navegación",
    );
  }

  menuToggle?.addEventListener("click", () => {
    setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
  });

  navigation?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  function updateThemeToggle() {
    const isLight = document.documentElement.dataset.theme === "light";
    themeToggle?.setAttribute("aria-checked", String(isLight));
  }

  if (themeToggle) {
    updateThemeToggle();
    themeToggle.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "light" ? "dark" : "light";

      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("portfolio-theme", nextTheme);
      updateThemeToggle();
    });
  }

  const sectionLinks = Array.from(
    navigation?.querySelectorAll<HTMLAnchorElement>("[data-section]") ?? [],
  );
  const sectionTargets = sectionLinks
    .map((link) => ({
      link,
      section: document.getElementById(link.dataset.section ?? ""),
    }))
    .filter(
      (
        target,
      ): target is {
        link: HTMLAnchorElement;
        section: HTMLElement;
      } => target.section !== null,
    );

  if (sectionTargets.length > 0) {
    const updateActiveSection = () => {
      const marker = window.innerHeight * 0.32;
      let activeTarget = sectionTargets[0];

      for (const target of sectionTargets) {
        if (target.section.getBoundingClientRect().top <= marker) {
          activeTarget = target;
        }
      }

      for (const target of sectionTargets) {
        const isActive = target === activeTarget;
        target.link.classList.toggle("active", isActive);
        if (isActive) {
          target.link.setAttribute("aria-current", "location");
        } else {
          target.link.removeAttribute("aria-current");
        }
      }
    };

    updateActiveSection();
    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("hashchange", updateActiveSection);
  }
</script>
