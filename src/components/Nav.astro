---
const links = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "Blog", href: "/blog" },
  { name: "More", href: "/more" },
];
const activePage = Astro.props.activePage || "home";
---

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: transparent;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    padding: 0 1rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    box-sizing: border-box;
  }

  .logo {
    font-weight: bold;
    color: var(--color-accent);
    font-size: 2.1rem;
    justify-self: start;
  }

  .nav-center {
    justify-self: center;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1.3rem;
    padding: 0.4rem 1rem;
    border-radius: 0.75rem;
    position: relative;
    font-weight: 600;
    transition: color 400ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  a::after {
    content: "";
    position: absolute;
    pointer-events: none;
    bottom: 0;
    left: 50%;
    width: 0%;
    height: 2px;
    background-color: var(--color-accent);
    transition:
      width 400ms cubic-bezier(0.25, 0.8, 0.25, 1),
      left 400ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  a:hover,
  a:focus,
  a.active {
    color: var(--color-text);
  }

  a.active::after {
    width: 100%;
    left: 0;
  }

  a:hover::after,
  a:focus::after {
    width: 100%;
    left: 0;
  }

  .theme-toggle {
    justify-self: end;
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 5.5rem;
    min-width: 5.5rem;
    max-width: 5.5rem;
    height: 2.625rem;
    padding: 0;
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-raised);
    font: inherit;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 50%;
    left: 3px;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-switch-thumb);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.24);
    transform: translate(3rem, -50%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(:root[data-theme="light"]) .theme-toggle-thumb {
    transform: translateY(-50%);
  }

  .theme-toggle svg {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: var(--color-text-subtle);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transform: translateY(-50%);
    transition: stroke 200ms ease;
  }

  .icon-sun {
    left: 0.6875rem;
  }

  .icon-moon {
    right: 0.6875rem;
  }

  :global(:root[data-theme="light"]) .icon-sun,
  :global(:root:not([data-theme="light"])) .icon-moon {
    stroke: var(--color-switch-icon-active);
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle-thumb {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    ul {
      flex-direction: column;
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .logo {
      justify-self: center;
    }

    .theme-toggle {
      justify-self: center;
    }
  }
</style>

<nav>
  <div class="container">
    <div class="logo">ND.</div>

    <div class="nav-center">
      <ul>
        {
          links.map(({ name, href }) => (
            <li>
              <a
                href={href}
                class={activePage === name.toLowerCase() ? "active" : ""}
                aria-current={
                  activePage === name.toLowerCase() ? "page" : undefined
                }
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      role="switch"
      aria-label="Modo claro"
      aria-checked="false"
      title="Alternar modo claro y oscuro"
    >
      <span class="theme-toggle-thumb" aria-hidden="true"></span>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path
          d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
        />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
      </svg>
    </button>
  </div>
</nav>

<script>
  const themeToggle =
    document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function updateThemeToggle() {
    const isLight = document.documentElement.dataset.theme === "light";
    themeToggle?.setAttribute("aria-checked", String(isLight));
  }

  if (themeToggle) {
    updateThemeToggle();
    themeToggle.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "light" ? "dark" : "light";

      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("portfolio-theme", nextTheme);
      updateThemeToggle();
    });
  }
</script>
