---
import Layout from "../layouts/Layout.astro";

const posts: Array<{ title: string; date: string; summary: string }> = [];
---

<Layout title="Blog | Nil Díaz" activePage="blog">
  <section class="page-intro">
    <p class="eyebrow">Notas y aprendizajes</p>
    <h1>Blog</h1>
    <p>
      Notas, aprendizajes y experiencias sobre desarrollo y tecnología.
    </p>
  </section>

  {
    posts.length > 0 ? (
      <div class="posts">
        {posts.map((post) => (
          <article class="post-card">
            <p class="post-date">{post.date}</p>
            <h2>{post.title}</h2>
            <p>{post.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">
        Todavía no hay publicaciones. Cuando añada artículos, aparecerán aquí.
      </p>
    )
  }
</Layout>

<style>
  .page-intro {
    max-width: 52rem;
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(2rem, 5vw, 3.5rem);
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .posts {
    max-width: 52rem;
    border-top: 1px solid var(--color-border);
  }

  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card h2 {
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .post-date {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .empty-state {
    max-width: 52rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  :global(.post-date) {
    color: var(--color-accent);
  }
</style>
